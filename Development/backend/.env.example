PORT=3001
NODE_ENV=development

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=change-this-db-password
DB_NAME=william_app

# JWT (min 32 chars in production)
JWT_SECRET=change-this-secret-in-production-min-32-chars

# OpenAI
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000
CLASSIC_FALLBACK_TO_RAG_ON_OPENAI_ERROR=true
JOURNEY_PLAN_TIMEOUT_MS=60000
OPENAI_BASE_URL=

# Story panel image generation — OpenAI
# Uses the same OPENAI_API_KEY by default.
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_TIMEOUT_MS=60000
OPENAI_IMAGE_SIZE=1024x1024

# CORS — frontend origin
CORS_ORIGIN=http://localhost:3000

# Optional proxy for William Classic.
# In the current local setup, direct access to api.openai.com may time out.
# If your network requires a proxy, set both HTTP_PROXY and HTTPS_PROXY.
HTTP_PROXY=
HTTPS_PROXY=
http_proxy=
https_proxy=

# Digital Expert (Docker container service)
RAG_SERVICE_URL=http://127.0.0.1:8010
RAG_SERVICE_EXPERT=li_songwei
RAG_SERVICE_AUTOSTART=false
RAG_SERVICE_WARMUP_ON_BOOT=true
RAG_SERVICE_HEALTH_TIMEOUT_MS=1500
RAG_SERVICE_QUERY_TIMEOUT_MS=45000
RAG_SUPPORT_GUIDANCE_TIMEOUT_MS=10000

# Voice service (Docker container)
VOICE_SERVICE_URL=http://127.0.0.1:8020
VOICE_SERVICE_AUTOSTART=false
VOICE_SERVICE_WARMUP_ON_BOOT=true
VOICE_SERVICE_HEALTH_TIMEOUT_MS=1500
VOICE_SERVICE_TRANSCRIBE_TIMEOUT_MS=45000
VOICE_SERVICE_ANALYZE_TIMEOUT_MS=45000
VOICE_SERVICE_HEALTH_CACHE_MS=10000

# OpenAI TTS (voice output)
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE_ZH=verse
OPENAI_TTS_VOICE_EN=sage
OPENAI_TTS_RESPONSE_FORMAT=mp3
OPENAI_TTS_TIMEOUT_MS=45000
OPENAI_TTS_INSTRUCTIONS_ZH=Speak in warm, calm, natural Mandarin Chinese. Keep a medium-slow pace with gentle pauses. Sound grounded, thoughtful, and conversational. Avoid sounding robotic, salesy, exaggerated, or overly cheerful.
OPENAI_TTS_INSTRUCTIONS_EN=Speak in a warm, calm, natural tone. Keep a medium-slow pace with gentle pauses. Sound grounded, thoughtful, and conversational. Avoid sounding robotic, salesy, exaggerated, or overly cheerful.

# Attachment parsing
ATTACHMENT_TEXT_LIMIT=8000
ATTACHMENT_SUMMARY_LIMIT=220
ATTACHMENT_EXCERPT_LIMIT=800
ATTACHMENT_CONTEXT_LIMIT=4
URL_IMPORT_TIMEOUT_MS=12000
URL_IMPORT_MAX_BYTES=2097152
URL_IMPORT_TEXT_LIMIT=12000
URL_IMPORT_EXCERPT_LIMIT=1000

# Shared memory system
MEMORY_RECENT_MESSAGE_LIMIT=8
MEMORY_SUMMARY_LOOKBACK_LIMIT=24
MEMORY_USER_MEMORY_LIMIT=12
MEMORY_DEBUG_EVENT_LIMIT=30
MEMORY_SESSION_DEBUG_LIMIT=20
DEBUG_MEMORY_API_ENABLED=true
