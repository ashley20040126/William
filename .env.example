# ── William Docker 部署环境变量 ──
# 复制此文件为 .env 并填写真实值

# 对外暴露端口（默认 80）
EXPOSE_PORT=80

# ── MySQL ──
DB_USER=william
DB_PASS=change-this-db-password
DB_NAME=william_app

# ── Backend ──
JWT_SECRET=change-this-jwt-secret-min-32-chars
OPENAI_API_KEY=sk-proj-...
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
CORS_ORIGIN=http://your-server-ip-or-domain

# 可选代理（国内服务器访问 OpenAI 时使用）
HTTP_PROXY=
HTTPS_PROXY=

# ── RAG service ──
# 在 william_algorithm/rag/.env 中单独配置
# 必须包含 OPENAI_API_KEY、RAG_DEFAULT_EXPERT 等

# ── Voice service ──
# 在 william_algorithm/voice/.env 中单独配置
